# Backend Environment Configuration
APP_NAME=SIH26136-Procurement-Platform
APP_ENV=development
DEBUG=true

# Database (defaults to SQLite if not set, or PostgreSQL)
DATABASE_URL=sqlite:///./sih26136_demo.db
# DATABASE_URL=postgresql://sih26136:password@localhost:5432/sih26136_db

# Security & JWT
JWT_SECRET_KEY=dev-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=120

# Storage
UPLOAD_DIR=./uploads/proposals
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=sih26136-proposals

# AI Settings
LLM_MODEL=gemini-pro
EMBEDDING_MODEL=all-MiniLM-L6-v2
