# ==============================================================================
# Git Ignore Configuration
# ==============================================================================

# Dependencies
node_modules/
frontend/node_modules/
__pycache__/
backend/**/__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
dist/
build/
.eggs/

# Python Virtual Environments
.venv/
venv/
backend/venv/
backend/.venv/
env/
ENV/

# Environment Variables & Secrets
.env
.env.*
!.env.example
backend/.env
backend/.env.*
!backend/.env.example
frontend/.env
frontend/.env.*
!frontend/.env.example

# IDE & Editor Configuration
.vscode/
.idea/
*.swp
*.swo
*~
*.suo
*.ntvs*
*.njsproj
*.sln

# Operating System Files
.DS_Store
Thumbs.db
desktop.ini
$RECYCLE.BIN/

# Test Caches & Coverage
.pytest_cache/
backend/.pytest_cache/
coverage/
.coverage
htmlcov/
*.coverage.*

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Database & SQLite State
*.db
*.db-journal
*.sqlite
*.sqlite3
backend/*.db
backend/*.sqlite*
sih26136_demo.db
test_*.db

# Uploaded User Documents & Runtime Files
uploads/
uploads/**
backend/uploads/
backend/uploads/**
!backend/uploads/**/.gitkeep
data/uploads/
data/minio/
*.pdf
*.docx
*.xlsx

# Frontend Build Outputs
frontend/dist/
frontend/dist-ssr/
frontend/.vite/

# Celery & Background Tasks
celerybeat-schedule
celerybeat.pid
